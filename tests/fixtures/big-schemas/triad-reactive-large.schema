 (Event RuntimeEvent)
 (Rejected RejectionReason)]
{
  CommitSequence Integer
  DatabaseDigest Integer
  ActorIdentifier String
  SocketPath String
  SignalRequest [(Record RecordIntent) (Observe ObserveIntent) (Subscribe SubscribeIntent opens RuntimeEventStream)]
  SignalReply [(Accepted RecordAccepted) (Observed ObservationReturned) (Subscribed SubscriptionStarted)]
  NexusRequest [(SignalPushed PushSignal) (SemaResultPushed PushSemaResult) ResolveMail ExpireMail]
  NexusReply [(Pushed PushedToSema) (Resolved MailResolved) MailExpired]
  SemaRequest [(Write WriteEntry) (Read ReadEntries) (Open OpenSubscription) (Close CloseSubscription)]
  SemaReply [(Written EntryWritten) (EntriesReturned EntriesRead) (Opened SubscriptionOpened) (Closed SubscriptionClosed)]
  AdminRequest [Drain Pause Resume (TakeSnapshot Snapshot)]
  AdminReply [Drained Paused Resumed (SnapshotAvailable SnapshotReady)]
  RuntimeEvent [(MailSentEvent MailSent belongs RuntimeEventStream) (MessageAcceptedEvent MessageAccepted belongs RuntimeEventStream) (MessageCommittedEvent MessageCommitted belongs RuntimeEventStream) (MessageFailedEvent MessageFailed belongs RuntimeEventStream)]
  RuntimeEventStream (Stream { token.SubscriptionToken opened.SubscriptionStarted event.RuntimeEvent close.SubscriptionToken })
  RejectionReason [Malformed Unauthorized Conflict Unsupported StaleVersion InternalError]
  RecordIntent { ActorIdentifier Entry }
  ObserveIntent Query
  SubscribeIntent Query
  RecordAccepted { RecordIdentifier CommitSequence }
  ObservationReturned RecordSet
  SubscriptionStarted SubscriptionToken
  PushSignal SignalRequest
  PushSemaResult SemaReply
  PushedToSema SemaRequest
  MailResolved SignalReply
  WriteEntry Entry
  ReadEntries Query
  OpenSubscription Query
  CloseSubscription SubscriptionToken
  EntryWritten { RecordIdentifier CommitSequence DatabaseDigest }
  EntriesRead { RecordSet DatabaseDigest }
  SubscriptionOpened { SubscriptionToken CommitSequence }
  SubscriptionClosed { SubscriptionToken CommitSequence }
  Snapshot SocketPath
  SnapshotReady { SocketPath DatabaseDigest }
  MailSent SignalRequest
  MessageAccepted SignalRequest
  MessageCommitted CommitSequence
  MessageFailed RejectionReason
  Entry { Topics Kind Description Magnitude ActorIdentifier }
  Topic String
  Topics Vector.Topic
  Description String
  Kind [Decision Principle Correction Clarification Constraint Observation Question]
  Magnitude [Minimum VeryLow Low Medium High VeryHigh Maximum]
  Kinds Vector.Kind
  Limit Optional.Integer
  Query { Topics Kinds Limit }
  RecordIdentifier Integer
  SubscriptionToken Integer
  Entries Vector.Entry
  ByTopic Map.(Topic RecordIdentifier)
  RecordSet { Entries ByTopic }
}
