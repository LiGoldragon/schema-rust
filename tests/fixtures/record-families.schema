{
  Vector Vector
  Optional Optional
  ScopeOf ScopeOf
  Map Map
  Bytes FixedBytes
}
[(Record Entry) (Observe Query)]
[(RecordAccepted RecordIdentifier) (RecordsObserved RecordSet)]
{
  Topic String
  Description String
  RecordIdentifier Integer
  Entry { Topic Description }
  Observation { Description }
