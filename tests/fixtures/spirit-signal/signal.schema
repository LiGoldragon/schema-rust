  IntentRecordedPayload { Entry RecordIdentifier }
  IntentClarifiedPayload { RecordIdentifier Entry }
  IntentSupersededPayload { RetiredIdentifiers Replacements RecordIdentifiers }
  IntentRetiredPayload { RecordIdentifier }
  IntentEvent [(IntentRecorded IntentRecordedPayload belongs IntentEventStream) (IntentClarified IntentClarifiedPayload belongs IntentEventStream) (IntentSuperseded IntentSupersededPayload belongs IntentEventStream) (IntentRetired IntentRetiredPayload belongs IntentEventStream)]
  IntentEventStream (Stream { token.SubscriptionToken opened.SubscriptionStarted event.IntentEvent close.SubscriptionToken })
  ValidationError [EmptyDomain EmptyDescription EmptyQueryDomain EmptyKeyword EmptySearchText EmptyQueryReferent StashHandleNotFound EmptyReferents]
